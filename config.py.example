#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
相册备份同步配置文件
包含所有可配置的常量

使用说明：
1. 复制此文件为 config.py
2. 根据实际情况修改以下配置
"""

from pathlib import Path
from datetime import date

# ============ 配置区域 ============

# Windows 本地源目录
SOURCE_BASE = Path("D:/path/to/your/album/backup/")  # 改为你的本地相册目录

# 远程 Linux 服务器配置
REMOTE_USER = "your_username"      # 改为你的 SSH 用户名
REMOTE_HOST = "192.168.x.x"        # 改为你的 Linux 服务器 IP
REMOTE_PORT = 22                   # SSH 端口（通常为22）

# 远程目标目录
REMOTE_TARGET_BASE = "/path/to/backup1"      # 第一个备份目标路径
REMOTE_TARGET_BASE2 = "/path/to/backup2"     # 第二个备份目标路径

# rsync 路径 (如果不在 PATH 中，需要指定完整路径)
RSYNC_PATH = "rsync"  # 或 "C:/cwRsync/bin/rsync.exe"

# SSH 路径 (使用 cwRsync 自带的 SSH)
SSH_PATH = r"D:\path\to\cwrsync\bin\ssh.exe"

# 清理时需要排除的目录名称集合
# 这些目录即使超过清理天数也不会被删除
# 示例: EXCLUDE_CLEANUP_DIRS = {"重要目录", "另一个目录"}
EXCLUDE_CLEANUP_DIRS = set()

# 视频切片配置 (split_video.py)
FFMPEG_PATH = r"D:\path\to\ffmpeg.exe"
SPLIT_TARGET_SIZE_MB = 256   # 每个切片的目标大小 (MB)
SPLIT_MIN_SIZE_MB = 256      # 只处理超过此大小的视频 (MB)
SPLIT_SIZE_RATIO = 0.95      # 切片时长估算安全系数, 防止关键帧对齐后超出目标大小
VIDEO_EXTENSIONS = {".mp4", ".mov", ".m4v"}

# 切片临时目录 (建议指向 SSD, 避免 HDD 同盘混合读写; 切完校验后拷回源目录)
# 设为 None 则在源文件旁边建 .splitting 临时目录
SPLIT_TMP_BASE = Path("F:/split_tmp")

# 只切片此日期之后(含当天)新增的视频, 之前的历史文件不动
# 设为 None 则不限制日期
SPLIT_MIN_DATE = date(2026, 8, 23)

# 同步前是否自动切片大视频 (sync_album_backup.py 主流程调用)
AUTO_SPLIT_BEFORE_SYNC = True

# ============ 配置结束 ============
